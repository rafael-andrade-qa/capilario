# Copie para .env.local e preencha. Só valores públicos do cliente entram aqui.
# URL do projeto Supabase (Project Settings > API ou `supabase status` no ambiente local)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a anon key legada. NUNCA use a service_role/secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
